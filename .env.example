# =====================================================================
#  LibreTranslate - cau hinh local
#  Moi thay doi o day can chay lai: ./scripts/ltctl restart
# =====================================================================

# --- Image ---------------------------------------------------------
# Dung tag co dinh (vd v1.9.6) neu muon tai lap chinh xac.
LT_IMAGE=libretranslate/libretranslate:latest

# --- Mang ----------------------------------------------------------
# CHI MO TREN LOOPBACK. Cong duy nhat cong bo ra host la WEB_PORT, va dia chi
# 127.0.0.1 duoc GHI CUNG trong docker-compose.yml chu khong lay tu day — de
# mot dong trong tep nay khong the vo tinh mo ca stack ra mang.
# LibreTranslate va engine khong cong bo cong nao; chi tiep can qua nginx.
WEB_PORT=5001
WEB_IMAGE=nginx:1.29-alpine

# --- Ngon ngu -------------------------------------------------------
# Chi tai model cho cac ngon ngu nay. Cap khong co model truc tiep
# (vd vi->ja) se tu dong dich bac cau qua tieng Anh.
LT_LOAD_ONLY=en,vi,zh,ja,ko

# --- Model ----------------------------------------------------------
# false: khong kiem tra update moi lan khoi dong -> boot nhanh, chay duoc offline.
# Lan chay dau tien van tu dong tai model (can mang).
# Muon cap nhat model: ./scripts/ltctl update-models
LT_UPDATE_MODELS=false

# --- Hieu nang (i5-1235U: 10 nhan / 12 luong, khong GPU) -------------
# LT_THREADS = so WORKER cua gunicorn (tien trinh rieng, KHONG phai thread).
# Moi worker nap model rieng -> tang so nay la nhan RAM len.
# 4 la du thoai mai cho 1 nguoi dung; tang neu nhieu client goi song song.
LT_THREADS=4
# Gioi han RAM cho container. Do 1.66 GB voi 8 worker sau khi da dich 6 cap.
LT_MEM_LIMIT=5g
# So thread OpenMP cho CTranslate2 (inference) MOI worker.
# Tong tai = LT_THREADS x OMP_NUM_THREADS; may co 12 luong nen 4x4 la vua.
OMP_NUM_THREADS=4

# --- Engine thu hai: EnViT5 (Hugging Face) --------------------------
# Chi en<->vi. Giay phep openrail. Convert sang CTranslate2 int8 luc build.
ENGINE_MODEL_ID=VietAI/envit5-translation
ENGINE_QUANT=int8
ENGINE_IMAGE=lt-engine-envit5:1
# So thread inference. Tong tai cua CA HAI engine khong nen vuot 12 luong.
ENGINE_INTRA_THREADS=4
# beam 1 = nhanh nhat, 2-4 = chat luong hon mot chut nhung cham hon
ENGINE_BEAM_SIZE=2
ENGINE_MEM_LIMIT=3g

# --- May doc: Piper (text-to-speech) --------------------------------
# Vi sao can may chu rieng: Chrome/Brave tren Linux khong kem giong nao,
# speechSynthesis.getVoices() tra ve mang rong -> nut "Doc" se im lang.
#
# Danh sach giong nuong vao image luc build (duong dan trong repo
# huggingface.co/rhasspy/piper-voices, KHONG kem duoi tep, cach nhau bang
# khoang trang). Doi danh sach thi phai build lai: ./scripts/ltctl rebuild-tts
# Moi giong 'medium' nang ~63 MB. Cac giong Viet khac: 25hours_single (low),
# vivos (x_low).
TTS_VOICES=vi/vi_VN/vais1000/medium/vi_VN-vais1000-medium en/en_US/amy/medium/en_US-amy-medium
TTS_IMAGE=lt-tts-piper:1
# Cat van ban dai hon muc nay truoc khi doc (phan hoi se co header X-Truncated).
# Client tu cat theo cau va doc noi tiep, nen day chi la chot chan.
TTS_MAX_CHARS=2000
# Bo dem WAV trong RAM, tinh bang MB. Doc lai cung mot doan se khong tong hop lai.
TTS_CACHE_MB=64
TTS_MEM_LIMIT=2g

# --- Web UI ---------------------------------------------------------
# UI goc cua LibreTranslate bi tat: ta da co UI rieng o :5001, giu no chi la
# them mot be mat tan cong ma khong dung toi.
LT_DISABLE_WEB_UI=true
LT_FRONTEND_TITLE=Local Translate
# UI goc cua LibreTranslate khong co ban tieng Viet du hoan chinh (bi loc bo),
# dat 'en' de tranh render <html lang="None"> — HTML khong hop le.
LT_FRONTEND_LANGUAGE=en
# 'auto' = o nguon de "Auto Detect" -> go thu tieng gi cung dich duoc.
# Dat cung mot ma ngon ngu se KHOA o nguon, go tieng khac vao se ra rac.
LT_FRONTEND_LANGUAGE_SOURCE=auto
LT_FRONTEND_LANGUAGE_TARGET=vi
# CANH BAO: day la do tre DEBOUNCE truoc khi UI goi /translate, tinh bang ms.
# KHONG phai timeout cua request. Dat cao = go xong ngoi cho, tuong nhu hong.
# Mac dinh goc cua LibreTranslate la 500.
LT_FRONTEND_TIMEOUT=500

# --- API ------------------------------------------------------------
# -1 = khong gioi han (hop ly khi chi chay local).
LT_CHAR_LIMIT=-1
LT_REQ_LIMIT=-1
# -1 = khong gioi han so chuoi trong 1 mang. Chi chay local nen khong can chan.
LT_BATCH_LIMIT=-1
# Bat dich file .docx/.odt/.pptx/.xlsx/.txt/.html qua POST /translate_file
LT_DISABLE_FILES_TRANSLATION=false
LT_SUGGESTIONS=false
# Bat /metrics kieu Prometheus neu sau nay muon giam sat
LT_METRICS=false
